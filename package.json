{
  "name": "dsh-atlassian-mcp",
  "version": "1.1.0",
  "description": "Confluence and Jira for [DSH] through Atlassian's remote MCP server, with a settings card that owns the endpoint.",
  "license": "MIT",
  "private": false,
  "type": "module",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "mcp",
    "atlassian",
    "confluence",
    "jira"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-mcp-manager": ">=0.2.2-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-mcp-manager": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/muhadif/dsh-atlassian-mcp.git"
  },
  "homepage": "https://github.com/muhadif/dsh-atlassian-mcp#readme",
  "bugs": {
    "url": "https://github.com/muhadif/dsh-atlassian-mcp/issues"
  }
}
